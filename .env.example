# PostgreSQL connection. Demo locally with Docker Compose or any Postgres 16 database.
# No FX API key is required.
DATABASE_URL="postgresql://sarf:sarf@localhost:5432/sarf?schema=public"

# Demo mode ships with zero secrets: the admin token falls back to "demo-admin"
# and live ingestion stays off unless you opt in. Set DEMO_MODE=false before a
# public deployment that should not accept the published demo token.
DEMO_MODE="true"

# Set to "true" to let the scheduled job fetch HMRC and US Treasury rates.
INGEST_LIVE="false"

# Required when DEMO_MODE=false. Overrides the demo token when set.
ADMIN_TOKEN=""

# Vercel Cron sends Authorization: Bearer $CRON_SECRET when this is set.
# Leave empty in local demo; the ingest route then accepts calls only in demo mode.
CRON_SECRET=""

# Optional plug-in. When set, live ingestion GETs this URL and expects a JSON
# array of { "date", "currency", "lydPerUnit", "note"? }. Use it only for a feed
# you are allowed to copy. There is no default, and the app never scrapes cbl.gov.ly.
CBL_FEED_URL=""
